# Traefik router rule. Copied to /srv/stacks/youtubemixer/.env on first deploy;
# the server copy is the source of truth after that (deploy.sh never overwrites it).
#
# Phase 1 (before DNS points at the VPS): test host only.
ROUTER_RULE=Host(`youtubemixer.69.62.117.27.sslip.io`)
#
# Phase 2 (after the Namecheap A records resolve to 69.62.117.27):
# ROUTER_RULE=Host(`youtubemixer.online`) || Host(`www.youtubemixer.online`) || Host(`youtubemixer.69.62.117.27.sslip.io`)
