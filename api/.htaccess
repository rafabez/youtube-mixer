# Security settings for API directory

# Prevent direct access to config files
<FilesMatch "^(config|config-secure|config-invidious|\.env).*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent access to .env file
<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

# Prevent access to .env.example
<Files ".env.example">
    Order Allow,Deny
    Deny from all
</Files>

# Enable error logging (optional, for debugging)
php_flag display_errors off
php_flag log_errors on

# Set maximum execution time
php_value max_execution_time 30

# ============================================
# OPÇÃO: Definir variáveis de ambiente via .htaccess
# ============================================
