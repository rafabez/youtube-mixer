# Nota: Nem todos os servidores permitem SetEnv em .htaccess

# SetEnv YOUTUBE_API_KEY "sua_api_key_aqui"
# SetEnv INVIDIOUS_INSTANCE "https://inv.nadeko.net"
# SetEnv MAX_RESULTS "20"
# SetEnv APP_ENV "production"
