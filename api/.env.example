# Copy to api/.env and fill in. api/.env is gitignored and never deployed by deploy/deploy.sh.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
# Restrict it to "YouTube Data API v3" and to the server's IP address.
# If empty, search falls back to Invidious.
YOUTUBE_API_KEY=

# Results per search (1-50)
MAX_RESULTS=30

# Seconds to cache search results (0 disables). Each YouTube search costs 100 of 10,000 daily quota units.
CACHE_DURATION=3600

# Preferred Invidious instance, plus optional comma-separated fallbacks.
# Instances with the API enabled from api.invidious.io are tried after these.
INVIDIOUS_INSTANCE=https://invidious.f5.si
INVIDIOUS_FALLBACK_INSTANCES=

APP_ENV=production
